{
  "name": "lance-li-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-content.mjs",
    "build": "pnpm typecheck && pnpm validate && node scripts/build.mjs && node scripts/verify-build.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "assets": "node scripts/generate-assets.cjs",
    "assets:social": "node scripts/generate-social-card.mjs",
    "build:lab": "node scripts/build-lab.mjs",
    "typecheck:lab": "tsc --noEmit -p tsconfig.lab.json"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "gsap": "^3.15.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "6.30.1",
    "vite": "^6.4.3"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/react": "18.3.0",
    "@types/react-dom": "18.3.0",
    "sharp": "^0.33.5",
    "typescript": "5.9.3"
  }
}
